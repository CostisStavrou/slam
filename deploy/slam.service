# systemd unit — keeps the app running, restarts it on crash or reboot.
# Install: sudo cp deploy/slam.service /etc/systemd/system/ && sudo systemctl enable --now slam
[Unit]
Description=Slam Beach Bar app
After=network.target

[Service]
User=slam
WorkingDirectory=/home/slam/app
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
